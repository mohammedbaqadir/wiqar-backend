# Copy to .dev.vars for local development, and set the same names as
# Cloudflare secrets in production. Never commit real values.

# Which store this service acts for (Store-Identifier).
SALLA_STORE=your-store-identifier

# The app's OAuth credentials (Partners Portal → the app → App Keys).
SALLA_CLIENT_ID=the-app-client-id
SALLA_CLIENT_SECRET=the-app-client-secret

# Verifies X-Salla-Signature on webhook calls (Partners Portal → the app → Webhooks).
WEBHOOK_SECRET=the-app-webhook-secret

# Optional bootstrap: a token pasted directly, for a quick local run before the
# app is installed anywhere. Superseded by the app.store.authorize webhook.
# SALLA_TOKEN=

# Optional: point admin + checkout calls at a mock to rehearse the flow.
# SALLA_API_BASE=http://127.0.0.1:9999

SALLA_APP_NAME=wiqar-backend
SALLA_APP_VERSION=0.1.0
